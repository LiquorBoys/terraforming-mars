# Slack bot credentials -- see SLACK_SETUP.md to obtain.
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_SIGNING_SECRET=replace-me

# Target Terraforming Mars server. Defaults to the community-run instance.
# Override only if you self-host TM.
TM_BASE_URL=https://terraforming-mars.herokuapp.com

# Optional "Claude plays" seat. Claude isn't a Slack user, so its player link
# is DMed to whoever runs Claude Code. Slack user id (U...). When unset, the
# DEFAULT_CLAUDE_OPERATOR name in src/claude.ts is looked up, then the host.
CLAUDE_OPERATOR_SLACK_USER_ID=
# ...or a name instead of an id (matched against Slack real/display names):
# CLAUDE_OPERATOR=Simas Glinskis
# Player name Claude is seated under. Defaults to "Claude".
CLAUDE_PLAYER_NAME=Claude

# Optional Claude runner (see claude-runner/README.md). When both are set,
# Claude's link goes to the runner, which plays the seat unattended; the
# operator above becomes the fallback.
CLAUDE_RUNNER_URL=
CLAUDE_RUNNER_SECRET=

# Optional games channel: a spectator link is posted here whenever a game is
# created. Channel id (C...) or name; invite the bot first. Unset = off.
SLACK_GAMES_CHANNEL=

# Optional shared operational log. Channel id (C...) or name of a channel the
# bot has been invited to (/invite @terraforming-mars). Every game created and
# every failure is posted there, with the TM server's error body and the
# Vercel request id. Unset = no log.
SLACK_LOG_CHANNEL=
